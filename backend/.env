# ======================================================
# SERVER CONFIGURATION
# ======================================================

PORT=5000

# ======================================================
# SUPABASE CONFIGURATION
# ======================================================

# Get these from your Supabase project settings
# https://supabase.com/dashboard
SUPABASE_PROJECT_URL=your_supabase_project_url_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# ======================================================
# EMAIL CONFIGURATION (Gmail)
# ======================================================

# Gmail address - use your Gmail account
# Make sure to enable "Less secure app access" or use App Password
EMAIL_ADDRESS=your_email@gmail.com

# Gmail password or App Password
# For 2FA enabled accounts, use App Password instead of account password
EMAIL_PASSWORD=your_email_password_here

# ======================================================
# AUTHENTICATION CONFIGURATION
# ======================================================

# Secret code required for admin registration
# Generate a strong random string for security
ADMIN_SECRET_CODE=your_super_secret_admin_code_here

# JWT token expiry times
# Access token expiry (short-lived)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token expiry (long-lived)
JWT_REFRESH_EXPIRES_IN=7d

# ======================================================
# QUIZ CONFIGURATION
# ======================================================

# Points awarded per correct question in quiz
# Can be overridden per quiz if needed
QUIZ_POINTS_PER_QUESTION=10

# ======================================================
# NODE ENVIRONMENT
# ======================================================

# development, staging, or production
NODE_ENV=development
